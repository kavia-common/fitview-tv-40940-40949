<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV with dark + green accent styling -->
    <style name="AppTheme" parent="Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorPrimary">@color/tv_accent</item>
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="browseTitleViewStyle">@style/OceanBrowseTitle</item>
        <!-- searchOrbViewStyle intentionally omitted for current leanback version compatibility -->
    </style>

    <style name="OceanBrowseTitle" parent="Widget.Leanback.TitleView">
        <item name="android:textColor">@color/tv_primary</item>
        <item name="android:background">@color/tv_surface</item>
    </style>
</resources>
